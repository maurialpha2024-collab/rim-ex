NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER prefix with NEXT_PUBLIC_, never send to the browser.
# Used only by src/lib/supabase/admin.ts (server-side reads of the public order book and trader stats).
# The admin dashboard (its own repo, admin-rim-ex) uses the same three values.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
